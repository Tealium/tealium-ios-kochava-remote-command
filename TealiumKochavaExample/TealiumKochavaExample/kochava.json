{
  "config": {
    "app_guid": "YOUR_APP_GUID",
    "log_level": "debug",
    "app_tracking_transparency_enabled": true,
    "att_authorization_wait_time": 30.0,
    "att_auto_request_authorization": true,
    "limit_ad_tracking": false,
    "sleep": false,
    "identity_link_ids": {
        "userID": "TEST123",
        "userName": "TestUser",
        "email": "test@example.com"
    },
    "configuration_params": {
      "$default.append$": {
        "privacy": {
          "deny_datapoints": ["device_name"]
        }
      }
    }
  },
  "mappings": {
      "event_title": "custom_event_name",
      "achievement_id": "event.achievement_id",
      "ad_network_name": "event.ad_network_name",
      "campaign_id": "event.ad_campaign_id",
      "campaign": "event.ad_campaign_name",
      "currency_code": "event.currency",
      "customer_id": "event.user_id,identity_link_ids.userID",
      "level": "event.level",
      "order_id": "event.order_id",
      "order_total": "event.total",
      "signup_method": "event.registration_method",
      "username": "event.user_name,identity_link_ids.userName",
      "duration": "event.duration",
      "completed": "event.completed",
      "success": "event.success",
      "description": "event.description",
      "source": "event.source",
      "deeplink_url": "event.uri",
      "activity_type": "event.info_string",
      "source_application": "event.source",
      "deeplink_type": "event.description",
      "deeplink_timeout": "event.duration",
      "deeplink_processed": "event.success",
      "launch_type": "event.info_string",
      "url_scheme": "event.source",
      "user_tier": "custom_values.subscription_tier",
      "limit_ad_tracking": "limit_ad_tracking",
      "custom_identifiers": "custom_identifiers",
      "privacy_profile_name": "privacy_profile_name",
      "privacy_datapoints": "privacy_datapoints",
      "privacy_enabled": "privacy_enabled"
    },
  "commands": {
      "launch": "initialize",
      "user_login": "custom,setidentitylinks",
      "user_register": "registrationcomplete",
      "unlock_achievement": "achievement",
      "level_complete": "levelcomplete",
      "screen_view": "view",
      "order": "purchase",
      "deeplink_test": "deeplink",
      "app_launch_no_deeplink": "custom",

      "setidentitylinks": "setidentitylinks",
      "setcustomidentifiers": "setcustomidentifiers",
      "set_custom_values": "setcustomvalues",
      "setsleep": "setsleep",
      "setapplimitadtracking": "setapplimitadtracking",
      "start": "start",
      "stop": "stop",
      "create_privacy_profile": "createprivacyprofile",
      "set_privacy_profile": "setprivacyprofile",
      "invalidate": "invalidate",
      "push_token_registered": "custom",
      "push_registration_failed": "custom",
      "push_received": "custom", 
      "push_opened": "custom",
      "push_displayed": "custom",
      "notification_auth_failed": "custom",
      "notification_auth_requested": "custom",
      "push_registration_requested": "custom",
      "local_notification_failed": "custom",
      "local_notification_scheduled": "custom",
      "url_scheme_open_attempted": "custom"
  }
}
